# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment
.env*
!.env.local.example

# deployment and generated files
.vercel
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# local secrets — the committed templates are .dev.vars.example / .env.local.example
.dev.vars

# TypeScript incremental build state
tsconfig.tsbuildinfo

# Gradle build output for the Spring backend (backend/.gitignore covers the rest)
/backend/build/
/backend/.gradle/

# Local agent settings
.claude/

# Scratch space and generated deliverables (evidence decks, PDFs, QA output). Large binaries; the
# scripts that produce them live under tmp/ and are regenerated rather than versioned.
/tmp/
/output/
/qa/
