# Copy to `.dev.vars` and fill in. `.dev.vars` is gitignored — never commit real values.
# Wrangler/Miniflare loads this into the Worker environment for `npm run dev`; in production the
# same names are set as Worker secrets.

# --- Where the login server is -------------------------------------------------
# The page render asks this backend who the browser is, so the workspace cannot open without it.
# Same value as `HANDOVER_API_TARGET` in `.env.local` — one is for the dev proxy in front of the
# app, this one is for the server render inside it. See app/session.ts.
HANDOVER_API_TARGET=http://localhost:8080

# Only needed when the Spring backend sets `handover.auth.gateway-secret`. Must match
# `HANDOVER_GATEWAY_SECRET` in `backend/.env` and in `.env.local`.
HANDOVER_GATEWAY_SECRET=
HANDOVER_GATEWAY_SECRET_HEADER=x-handover-gateway-secret

# --- OpenAI -------------------------------------------------------------------
# Without a key the five model-backed endpoints answer 503 and the rest of the app works normally.
OPENAI_API_KEY=
# The model is fixed to gpt-5.6-luna in app/ai-shared.ts.
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
# 추론 강도(none | low | medium | high | xhigh | max). 정확도 우선 기본값은 high입니다.
# OPENAI_REASONING_EFFORT=xhigh

# --- Legacy: the Cloudflare D1 route handlers ---------------------------------
# `app/api/**` still authenticates with the ChatGPT proxy's identity headers and these email allow
# lists. The login screen no longer produces such an identity, so that backend cannot serve the app
# as it stands; it is left in the tree, unused, until it is either updated or removed.
# HANDOVER_ADMIN_EMAILS=admin@example.com
# HANDOVER_MEMBER_EMAILS=member-one@example.com,member-two@example.com
