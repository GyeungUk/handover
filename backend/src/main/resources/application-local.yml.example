# Copy to src/main/resources/application-local.yml and run with SPRING_PROFILES_ACTIVE=local.
# That file is gitignored. Prefer the environment variables in .env.example for anything secret;
# this file exists for the values that are awkward to export by hand while developing.
spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/handover
    username: handover
    password: handover

handover:
  auth:
    # 로그인에 쓰는 직번. 목록에 없는 직번은 비밀번호 생성도, 로그인도 할 수 없습니다.
    admin-employee-ids:
      - "20180001"
    member-employee-ids:
      - "20190002"
      - "20190003"
    session:
      # 로컬은 http라 secure 쿠키를 쓸 수 없습니다.
      secure: false
    password-reset:
      # SMTP 없이 개발할 때만. 인증번호를 메일 대신 로그에 씁니다.
      log-code: true
  cors:
    allowed-origins:
      - http://localhost:3000
    allow-credentials: true
  openai:
    # Never commit a real key. Export OPENAI_API_KEY instead, or put it here in your untracked copy.
    api-key: ""

logging:
  level:
    com.globalaffairs.handover: DEBUG
