# Copy to backend/.env and fill in. `.env` is gitignored; never commit real values.
# Load it however you prefer, e.g.  set -a && source .env && set +a && ./gradlew bootRun

# --- Database -----------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/handover
DATABASE_USERNAME=handover
DATABASE_PASSWORD=handover

# Used by docker-compose.yml when it creates the local database.
POSTGRES_DB=handover
POSTGRES_USER=handover
POSTGRES_PASSWORD=handover
POSTGRES_PORT=5432

# --- Authorisation ------------------------------------------------------------
# Comma-separated employee numbers. The administrator list grants admin privileges. Every numeric
# employee number can create and use a regular member account; the member list is retained for
# configuration compatibility and does not restrict sign-up.
HANDOVER_ADMIN_EMPLOYEE_IDS=20180001
HANDOVER_MEMBER_EMPLOYEE_IDS=20190002,20190003

# Optional shared secret the frontend gateway sends. When set, a caller that bypasses the gateway
# can neither use a session nor reach /api/auth/*. Must match `.env.local` and `.dev.vars`.
HANDOVER_GATEWAY_SECRET=
HANDOVER_GATEWAY_SECRET_HEADER=x-handover-gateway-secret

# --- Session cookie -----------------------------------------------------------
HANDOVER_SESSION_TTL=14d
# Must be false for plain-http local development, and true anywhere reachable over HTTPS.
HANDOVER_SESSION_COOKIE_SECURE=false
HANDOVER_SESSION_COOKIE_SAME_SITE=Lax

# --- 비밀번호 찾기 --------------------------------------------------------------
# The reset code is mailed to the address the account registered. With no SMTP_HOST no mail sender
# exists and the endpoint answers 503 rather than dropping the message.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
HANDOVER_MAIL_FROM=no-reply@example.ac.kr
HANDOVER_MAIL_FROM_NAME=국제처 업무 인수인계

HANDOVER_PASSWORD_RESET_TTL=10m
HANDOVER_PASSWORD_RESET_MAX_ATTEMPTS=5
HANDOVER_PASSWORD_RESET_MAX_PER_HOUR=5
# Local development escape hatch: writes the code to the log instead of sending mail. It refuses to
# start a reset while a mail server is also configured, so it cannot be left on by accident.
HANDOVER_PASSWORD_RESET_LOG_CODE=false

# --- Browser access -----------------------------------------------------------
# Exact origins the Next.js frontend is served from. Empty disables CORS entirely.
HANDOVER_CORS_ALLOWED_ORIGINS=http://localhost:3000
HANDOVER_CORS_ALLOW_CREDENTIALS=true

# --- 초안 정책 ---
# 모델이 계획만 보고 채워도 되는 속성 key. 마감일이나 협업 부서 같은 '사실'은 여기 넣지 마세요.
HANDOVER_DRAFT_INFERABLE_PROPERTY_KEYS=importance,impact,response,priority

# --- OpenAI -------------------------------------------------------------------
# Leave this empty. The project's `.dev.vars` already holds the key for the Next.js dev server, and
# `./run-local.sh` reads it from there, so the secret stays in one file instead of two.
# Set it here (or in the environment) only for a deployment that has no `.dev.vars`.
# Without a key the five model-backed endpoints answer 503, exactly as the Worker did.
OPENAI_API_KEY=
# 모델은 코드에서 gpt-5.6-luna로 고정됩니다.
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
# 추론 강도: none | low | medium | high | xhigh | max. 정확도 우선 기본값은 high입니다.
OPENAI_REASONING_EFFORT=xhigh
OPENAI_TIMEOUT=120s

# --- Server -------------------------------------------------------------------
SERVER_PORT=8080
LOG_LEVEL=INFO
